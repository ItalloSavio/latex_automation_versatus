\newcommand{\RenderDynamicCover}{%
% LOGO_PLACEMENT x=1.5 y=27.0 height=1.5 bg=light
\definecolor{bg_primary}{HTML}{201F1E}
\definecolor{bg_secondary}{HTML}{2B2928}
\definecolor{accent_1}{HTML}{4CB6B4}
\definecolor{accent_2}{HTML}{DD4F51}
\definecolor{neutral}{HTML}{BCB9B9}
\definecolor{light}{HTML}{FFFFFF}
\definecolor{muted}{HTML}{5D5956}
\begin{tikzpicture}[remember picture, overlay,
  shift={(current page.south west)}, x=1cm, y=1cm]
  %
  % --- BACKGROUND ---
  %
  % Base background (covers light zones: Top-Left, Middle-Right, Bottom-Left)
  \fill[light] (-1,-1) rectangle (22, 30.7);

  % Top-Right Block (y: 19.8 to 29.7)
  \fill[accent_2] (10.5, 19.8) -- (10.5, 30.7) -- (22, 19.8) -- cycle;
  \fill[bg_primary] (10.5, 30.7) -- (22, 30.7) -- (22, 19.8) -- cycle;

  % Middle-Left Block (y: 9.9 to 19.8)
  \fill[bg_primary] (-1, 19.8) -- (10.5, 19.8) -- (-1, 9.9) -- cycle;
  \fill[accent_2] (-1, 9.9) -- (10.5, 19.8) -- (10.5, 9.9) -- cycle;

  % Bottom-Right Block (y: 0 to 9.9)
  \fill[accent_2] (10.5, 9.9) -- (10.5, -1) -- (22, 9.9) -- cycle;
  \fill[bg_primary] (10.5, -1) -- (22, -1) -- (22, 9.9) -- cycle;

  % --- TEXT ---
  %
  % Author / Info (Top-Right Orange Zone)
  \node[anchor=north west, text width=9cm, align=flush left] at (11.0, 25.0) {%
    {\fontsize{12}{16}\selectfont\bfseries\color{VSCoverFg}\BookAuthor}%
  };

  % Subtitle (Middle-Right Light Zone, Top)
  \node[anchor=north west, text width=9cm, align=flush left] at (11.0, 18.5) {%
    {\fontsize{14}{18}\selectfont\bfseries\color{VSCoverSubFg}\BookSubtitle}%
  };

  % Separator Line
  \draw[VSRed, line width=1.2pt] (11.0, 14.85) -- (20.0, 14.85);

  % Title (Middle-Right Light Zone, Bottom)
  \node[anchor=south west, text width=9cm, align=flush left] at (11.0, 10.5) {%
    {\fontsize{50}{55}\selectfont\bfseries\color{VSCoverFg}\BookTitle}%
  };

  % Description (Bottom-Right Orange Zone)
  \node[anchor=north west, text width=9cm, align=flush left] at (11.0, 8.5) {%
    {\fontsize{12}{16}\selectfont\bfseries\color{VSCoverSubFg}\BookDescription}%
  };

  % Date / Version (Bottom-Left Light Zone)
  \node[anchor=south west, text width=9cm, align=flush left] at (1.5, 1.5) {%
    {\fontsize{10}{14}\selectfont\color{VSCoverFaintFg}\BookDate\ | \ \BookVersion}%
  };

\end{tikzpicture}%
}