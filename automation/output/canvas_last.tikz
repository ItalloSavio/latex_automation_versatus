\newcommand{\RenderDynamicCover}{%
\definecolor{bg_primary}{HTML}{201F1E}
\definecolor{bg_secondary}{HTML}{2B2928}
\definecolor{accent_1}{HTML}{4CB6B4}
\definecolor{accent_2}{HTML}{DD4F51}
\definecolor{neutral}{HTML}{BCB9B9}
\definecolor{light}{HTML}{FFFFFF}
\definecolor{muted}{HTML}{5D5956}
\begin{tikzpicture}[remember picture, overlay,
  shift={(current page.south west)}, x=1cm, y=1cm]
  
  % Background
  \fill[bg_primary] (-1,-1) rectangle (22,30.7);

  % Grid unit
  \pgfmathsetmacro{\s}{2.625}

  % --- TOP GRID (Rows 10-11) ---
  % Row 11
  \fill[accent_2] (0, 11*\s) -- (\s, 11*\s) -- (\s, 12*\s) -- cycle;
  \fill[light] (\s, 11*\s) -- (2*\s, 11*\s) -- (\s, 12*\s) -- cycle;
  \fill[muted] (2.5*\s, 11.5*\s) circle (0.5*\s);
  \fill[accent_2] (3*\s, 11*\s) -- (4*\s, 11*\s) -- (3*\s, 12*\s) -- cycle;
  \fill[accent_1] (3*\s, 12*\s) -- (4*\s, 12*\s) -- (4*\s, 11*\s) -- cycle;

  % Row 10
  \fill[accent_2] (0, 11*\s) -- (\s, 11*\s) -- (\s, 10*\s) -- cycle;
  \fill[light] (\s, 11*\s) -- (2*\s, 11*\s) -- (\s, 10*\s) -- cycle;
  \fill[accent_1] (2*\s, 11*\s) -- (3*\s, 11*\s) -- (3*\s, 10*\s) -- cycle;
  \fill[light] (3*\s, 11*\s) -- (4*\s, 11*\s) -- (3*\s, 10*\s) -- cycle;

  % --- LARGE CENTRAL COMPOSITION (Rows 6-9) ---
  % Center at (2s, 8s)
  % Top-Left Quadrant
  \fill[accent_1] (2*\s, 8*\s) -- (0, 8*\s) arc (180:90:2*\s) -- cycle;
  \fill[light] (2*\s, 8*\s) -- (\s, 8*\s) arc (180:90:\s) -- cycle;
  % Top-Right Quadrant
  \fill[accent_2] (2*\s, 8*\s) -- (4*\s, 8*\s) arc (0:90:2*\s) -- cycle;
  \fill[bg_primary] (2*\s, 8*\s) -- (3*\s, 8*\s) arc (0:90:\s) -- cycle;
  % Bottom-Left Quadrant
  \fill[light] (2*\s, 8*\s) -- (0, 8*\s) arc (180:270:2*\s) -- cycle;
  \fill[accent_2] (2*\s, 8*\s) -- (\s, 8*\s) arc (180:270:\s) -- cycle;
  % Bottom-Right Quadrant
  \fill[muted] (2*\s, 8*\s) -- (4*\s, 8*\s) arc (0:-90:2*\s) -- cycle;
  \fill[bg_primary] (2*\s, 8*\s) -- (3*\s, 8*\s) arc (0:-90:\s) -- cycle;
  
  % Floating White Circle
  \fill[light] (4.5*\s, 8.5*\s) circle (0.5*\s);

  % --- BOTTOM GRID (Rows 0-5) ---
  % Row 5
  \fill[accent_2] (0, 6*\s) -- (\s, 6*\s) -- (\s, 5*\s) -- cycle;
  \fill[light] (\s, 6*\s) -- (2*\s, 6*\s) -- (\s, 5*\s) -- cycle;
  \fill[accent_1] (2*\s, 6*\s) -- (3*\s, 6*\s) -- (3*\s, 5*\s) -- cycle;
  \fill[light] (3*\s, 6*\s) -- (4*\s, 6*\s) -- (3*\s, 5*\s) -- cycle;

  % Row 4
  \fill[accent_1] (0, 4*\s) -- (\s, 4*\s) -- (\s, 5*\s) -- cycle;
  \fill[accent_2] (\s, 4*\s) -- (2*\s, 4*\s) -- (\s, 5*\s) -- cycle;
  \fill[light] (2*\s, 4*\s) -- (3*\s, 4*\s) -- (3*\s, 5*\s) -- cycle;
  \fill[accent_2] (3.5*\s, 4.5*\s) circle (0.5*\s);

  % Row 3
  \fill[accent_1] (0, 4*\s) -- (\s, 4*\s) -- (\s, 3*\s) -- cycle;
  \fill[accent_1] (\s, 4*\s) -- (2*\s, 4*\s) -- (\s, 3*\s) -- cycle;

  % Row 2 (Teal Semi-circle)
  \fill[accent_1] (0, 2*\s) arc (180:0:\s) -- cycle;

  % Row 1
  \fill[light] (0, 2*\s) -- (\s, 2*\s) -- (\s, \s) -- cycle;
  \fill[accent_2] (\s, 2*\s) -- (2*\s, 2*\s) -- (\s, \s) -- cycle;

  % Row 0
  \fill[accent_2] (0, \s) -- (\s, \s) -- (\s, 0) -- cycle;
  \fill[light] (0, 0) arc (180:0:\s) -- cycle;

  % --- LOGO ICON & ACCENT LINE ---
  % Red accent line
  \fill[accent_2] (12.2, 23.3) rectangle (15.0, 23.4);

  % Geometric Icon (V-shape)
  \fill[accent_2] (11.7, 27.5) -- (12.4, 29.5) -- (12.4, 28.5) -- (11.7, 26.5) -- cycle;
  \fill[accent_2] (12.6, 26.5) -- (13.3, 28.5) -- (13.3, 27.5) -- (12.6, 25.5) -- cycle;

\end{tikzpicture}%
}