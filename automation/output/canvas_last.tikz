\newcommand{\RenderDynamicCover}{%
\definecolor{bg_primary}{HTML}{4038FF}
\definecolor{bg_secondary}{HTML}{C7B99C}
\definecolor{accent_1}{HTML}{C7B99C} % Used for yellow, but hex is beige
\definecolor{accent_2}{HTML}{3B3CD0} % Used for light blue and green, but hex is darker blue
\definecolor{neutral}{HTML}{C6C6C8} % Used for off-white
\definecolor{light}{HTML}{FFFFFF}   % Used for magenta, but hex is white
\definecolor{muted}{HTML}{757576}   % Used for dark grey
\begin{tikzpicture}[remember picture, overlay,
  shift={(current page.south west)}, x=1cm, y=1cm]

  % Page dimensions: A4 (21cm x 29.7cm)
  % Origin: (0,0) at bottom-left
  % Bleed: extend shapes 1 cm beyond all edges (-1,-1) to (22, 30.7)

  % --- Geometric Background ---
  % The main colored block is a rectangle from y=17.8cm to y=29.7cm, width 21cm.
  % Height = 29.7 - 17.8 = 11.9cm.
  % This block is conceptually a 2x2 grid of cells, each 10.5cm wide x 5.95cm tall.

  % Define key coordinates for clarity
  \coordinate (P_TL) at (0, 29.7);     % Top-Left of page
  \coordinate (P_TR) at (21, 29.7);    % Top-Right of page
  \coordinate (P_BL) at (0, 17.8);     % Bottom-Left of color block
  \coordinate (P_BR) at (21, 17.8);    % Bottom-Right of color block

  \coordinate (P_M_top) at (10.5, 29.7);    % Mid-point of top edge of color block
  \coordinate (P_M_left) at (0, 23.75);    % Mid-point of left edge of color block (17.8 + 11.9/2)
  \coordinate (P_M_right) at (21, 23.75);   % Mid-point of right edge of color block
  \coordinate (P_M_bottom) at (10.5, 17.8); % Mid-point of bottom edge of color block
  \coordinate (P_center) at (10.5, 23.75);  % Center of the 2x2 grid

  % 1. Main background color (light beige/grey)
  \fill[bg_secondary] (-1,-1) rectangle (22,30.7);

  % 2. Top-Left quadrant (Dark Blue) - solid rectangle
  \fill[bg_primary] (P_M_left) rectangle (P_M_top); % (0, 23.75) to (10.5, 29.7)

  % 3. Bottom-Right quadrant (Dark Grey) - solid rectangle
  \fill[muted] (P_M_bottom) rectangle (P_M_right); % (10.5, 17.8) to (21, 23.75)

  % 4. Top-Right quadrant (split diagonally into Light Blue and Green)
  % Light Blue triangle (top-right part of cell)
  \fill[accent_2] (P_M_top) -- (P_TR) -- (P_M_right) -- cycle; % (10.5, 29.7) -- (21, 29.7) -- (21, 23.75)
  % Green triangle (bottom-left part of cell)
  \fill[accent_2] (P_M_top) -- (P_center) -- (P_M_right) -- cycle; % (10.5, 29.7) -- (10.5, 23.75) -- (21, 23.75)

  % 5. Bottom-Left quadrant (split diagonally into Magenta and Red)
  % Magenta triangle (top-left part of cell)
  \fill[light] (P_M_left) -- (P_center) -- (P_BL) -- cycle; % (0, 23.75) -- (10.5, 23.75) -- (0, 17.8)
  % Red triangle (bottom-right part of cell)
  \fill[bg_primary] (P_BL) -- (P_M_bottom) -- (P_center) -- cycle; % (0, 17.8) -- (10.5, 17.8) -- (10.5, 23.75)

  % 6. Large central Yellow triangle (overlaps previous shapes)
  \fill[accent_1] (P_M_bottom) -- (P_M_left) -- (P_M_right) -- cycle; % (10.5, 17.8) -- (0, 23.75) -- (21, 23.75)

  % 7. Large central Off-white (neutral) triangle (overlaps previous shapes, including yellow)
  \fill[neutral] (P_M_top) -- (P_M_left) -- (P_M_right) -- cycle; % (10.5, 29.7) -- (0, 23.75) -- (21, 23.75)

\end{tikzpicture}%
}
% === COVER_LAYOUT ===
\renewcommand{\VSCoverTopMargin}{16.4cm}
\renewcommand{\VSCoverLeftIndent}{2.05cm}
\renewcommand{\VSCoverTextWidth}{0.80}
\renewcommand{\VSCoverTitlePt}{40}
\renewcommand{\VSCoverTitleLeadPt}{48}
\renewcommand{\VSCoverSubtitlePt}{9}
\renewcommand{\VSCoverSubtitleLeadPt}{11}
\renewcommand{\VSCoverTitleAlign}{\centering}
% === END_COVER_LAYOUT ===