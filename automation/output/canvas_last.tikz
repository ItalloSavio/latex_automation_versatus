\newcommand{\RenderDynamicCover}{%
% LOGO_PLACEMENT x=1.5 y=26.0 height=1.5 bg=neutral
\definecolor{bg_primary}{HTML}{201F1E}
\definecolor{bg_secondary}{HTML}{2B2928}
\definecolor{accent_1}{HTML}{4CB6B4}
\definecolor{accent_2}{HTML}{DD4F51}
\definecolor{neutral}{HTML}{BCB9B9}
\definecolor{light}{HTML}{FFFFFF}
\definecolor{muted}{HTML}{5D5956}
\begin{tikzpicture}[remember picture, overlay,
  shift={(current page.south west)}, x=1cm, y=1cm]
  %
  % --- BACKGROUND ---
  % Main background for text area and bleed
  \fill[neutral] (-1,-1) rectangle (22, 30.7);

  % Geometric pattern (20x20cm square, centered horizontally, top 2/3 of page)
  % Left edge: 0.5cm, Right edge: 20.5cm
  % Bottom edge: 9.7cm, Top edge: 29.7cm
  % Center point of the pattern: (10.5, 19.7)

  % Top-left square (Dark Blue in reference)
  \fill[bg_primary] (0.5, 19.7) rectangle (10.5, 29.7);

  % Top-right quadrant (split diagonally)
  % Top-left triangle (Bright Cyan in reference)
  \fill[accent_1] (10.5, 19.7) -- (10.5, 29.7) -- (20.5, 29.7) -- cycle;
  % Bottom-right triangle (Green in reference)
  \fill[accent_1] (10.5, 19.7) -- (20.5, 19.7) -- (20.5, 29.7) -- cycle;

  % Bottom-left quadrant (split diagonally)
  % Top-left triangle (Magenta in reference)
  \fill[accent_2] (0.5, 19.7) -- (0.5, 9.7) -- (10.5, 19.7) -- cycle;
  % Bottom-right triangle (Red in reference)
  \fill[accent_2] (0.5, 9.7) -- (10.5, 9.7) -- (10.5, 19.7) -- cycle;

  % Bottom-right quadrant (split diagonally)
  % Top-left triangle (White/Light Grey in reference)
  \fill[light] (10.5, 19.7) -- (10.5, 9.7) -- (20.5, 9.7) -- cycle;
  % Bottom-right triangle (Yellow in reference)
  \fill[muted] (10.5, 19.7) -- (20.5, 19.7) -- (20.5, 9.7) -- cycle;

  %
  % --- TEXT ---
  % Book Title (david bowie)
  \node[anchor=south west, text width=15cm, align=left] at (3.5, 12.0) {%
    {\fontsize{32}{38}\selectfont\bfseries\color{VSCoverFg}\BookTitle}%
  };

  % Separator line
  \draw[VSRed, line width=1.2pt] (3.5, 11.0) -- (18.5, 11.0);

  % Bottom text columns
  % Column 1: Book Description
  \node[anchor=south west, text width=5cm, align=left] at (3.5, 2.5) {%
    {\fontsize{11}{15}\selectfont\color{VSCoverSubFg}\BookDescription}%
  };

  % Column 2: Book Subtitle (used for event details)
  \node[anchor=south west, text width=5cm, align=left] at (9.5, 2.5) {%
    {\fontsize{11}{15}\selectfont\color{VSCoverSubFg}\BookSubtitle}%
  };

  % Column 3: Book Date | Book Version
  \node[anchor=south west, text width=5cm, align=left] at (15.5, 2.5) {%
    {\fontsize{10}{14}\selectfont\color{VSCoverFaintFg}\BookDate\ |\ \BookVersion}%
  };

  % Book Author (required, but no explicit author in image other than title)
  % This node will be invisible if \BookAuthor is empty.
  \node[anchor=south west, text width=5cm, align=left] at (3.5, 1.5) {%
    {\fontsize{11}{15}\selectfont\color{VSCoverMutedFg}\BookAuthor}%
  };

\end{tikzpicture}%
}