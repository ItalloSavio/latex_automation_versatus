\newcommand{\RenderDynamicCover}{%
% LOGO_PLACEMENT x=2.0 y=27.2 height=1.2 bg=light
\definecolor{bg_primary}{HTML}{4038FF}
\definecolor{bg_secondary}{HTML}{C7B99C}
\definecolor{accent_1}{HTML}{C7B99C}
\definecolor{accent_2}{HTML}{3B3CD0}
\definecolor{neutral}{HTML}{C6C6C8}
\definecolor{light}{HTML}{FFFFFF}
\definecolor{muted}{HTML}{757576}
\begin{tikzpicture}[remember picture, overlay,
  shift={(current page.south west)}, x=1cm, y=1cm]
  %
  % --- BACKGROUND ---
  %
  \fill[light] (-1,-1) rectangle (22,30.7);
  
  % Horizontal separator lines
  \draw[muted, line width=0.5pt] (2.0, 26.5) -- (19.0, 26.5);
  \draw[muted, line width=0.5pt] (2.0, 4.5) -- (19.0, 4.5);
  
  %
  % --- TEXT ---
  %
  
  % Series (Top Center)
  \node[anchor=north west, text width=8cm, align=flush left] at (7.5, 27.8) {%
    {\fontsize{10}{12}\selectfont\bfseries\color{VSCoverFg}\BookSeries}%
  };

  % Date (Top Right)
  \node[anchor=north east, text width=5cm, align=flush right] at (19.0, 27.8) {%
    {\fontsize{10}{12}\selectfont\color{VSCoverMutedFg}\BookDate}%
  };

  % Title (Center Left)
  \node[anchor=north west, text width=6cm, align=flush left] at (7.5, 24.0) {%
    {\fontsize{22}{26}\selectfont\bfseries\color{VSCoverFg}\BookTitle}%
  };

  % Subtitle (Below Title)
  \node[anchor=north west, text width=6cm, align=flush left] at (7.5, 19.5) {%
    {\fontsize{14}{18}\selectfont\color{VSCoverSubFg}\BookSubtitle}%
  };

  % Description (Center Right)
  \node[anchor=north west, text width=6cm, align=flush left] at (13.5, 24.0) {%
    {\fontsize{11}{14}\selectfont\color{VSCoverSubFg}\BookDescription}%
  };

  % Separator Line (as required by rules, placed between title and subtitle zones)
  \draw[VSRed, line width=1.2pt] (7.5, 20.5) -- (13.5, 20.5);

  % Author (Bottom Left)
  \node[anchor=south west, text width=10cm, align=flush left] at (2.0, 3.5) {%
    {\fontsize{11}{14}\selectfont\bfseries\color{VSCoverFg}\BookAuthor}\\[1mm]
    {\fontsize{9}{11}\selectfont\color{VSCoverMutedFg}\BookConfidentiality}%
  };

  % Date | Version (Bottom Right)
  \node[anchor=south east, text width=6cm, align=flush right] at (19.0, 3.5) {%
    {\fontsize{10}{12}\selectfont\color{VSCoverFaintFg}\BookDate\ |\ \BookVersion}%
  };

\end{tikzpicture}%
}