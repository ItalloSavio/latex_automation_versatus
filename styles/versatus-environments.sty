  colframe=VSBlack,
  coltitle=VSPaperWhite,
  boxrule=0.4pt,
  arc=1.2mm,
  left=2mm,right=2mm,top=1.2mm,bottom=1.2mm,
  fonttitle=\bfseries,
  title={Nota técnica},
  #1
}

